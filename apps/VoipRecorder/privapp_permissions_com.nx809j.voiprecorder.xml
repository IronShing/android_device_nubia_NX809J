<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged-permission allowlist for the VoIP Call Recorder.
     Installed to /product/etc/permissions/. -->
<permissions>
    <privapp-permissions package="com.nx809j.voiprecorder">
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT"/>
        <permission name="android.permission.CAPTURE_VOICE_COMMUNICATION_OUTPUT"/>
        <permission name="android.permission.MODIFY_AUDIO_ROUTING"/>
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
    </privapp-permissions>
</permissions>
