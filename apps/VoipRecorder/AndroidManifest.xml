<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nx809j.voiprecorder"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT"/>
    <!-- signature|privileged: unblocks capture of USAGE_VOICE_COMMUNICATION output -->
    <uses-permission android:name="android.permission.CAPTURE_VOICE_COMMUNICATION_OUTPUT"/>
    <!-- signature|privileged: register a dynamic AudioPolicy / AudioMix loopback -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- call detection: watch the RECORD_AUDIO app-op of OTHER apps (signature|privileged) -->
    <uses-permission android:name="android.permission.WATCH_APPOPS"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <!-- foreground service + notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- "Record calls from X?" answers go into the Secure lists RM Control edits -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <!-- self-enable the on-demand notification peek (contact name of the call) -->
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS"/>

    <!-- save recordings to shared storage -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <application
        android:name=".RecorderApp"
        android:persistent="true"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false">

        <!-- No launcher entry: the switches and the consent text are in RedMagic Control
             (Privacy tab), which also opens this browser. Exported only to holders of
             WRITE_SECURE_SETTINGS (i.e. RM Control / Settings), not to third-party apps. -->
        <activity
            android:name=".RecordingsActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@style/Theme.VoipRecorder"
            android:label="@string/recordings_title"/>

        <!-- Serves /sdcard/CallRecordings/*.wav to the player picked by ACTION_VIEW
             (file:// URIs are blocked by StrictMode on a current targetSdk). -->
        <provider
            android:name=".RecordingProvider"
            android:authorities="com.nx809j.voiprecorder.recordings"
            android:exported="false"
            android:grantUriPermissions="true"/>

        <service
            android:name=".CallMonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Auto-records allow-listed VoIP calls in the background"/>
        </service>

        <!-- Bound only for the seconds it takes to read the calling app's ongoing-call
             notification (contact name); unbinds itself when idle. -->
        <service
            android:name=".CallNotifPeek"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
            <meta-data android:name="android.service.notification.default_filter_types"
                android:value="ongoing"/>
        </service>

        <receiver android:name=".DecisionReceiver" android:exported="false"/>
    </application>
</manifest>
