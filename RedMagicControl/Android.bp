android_app {
    name: "RedMagicControl",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: { enabled: false },
    dex_preopt: { enabled: false },
}
