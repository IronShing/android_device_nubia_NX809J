<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nubia.rmcontrol"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- WAKE_LOCK (normal perm): required to hold a WifiLock for the game-mode
         max-wifi boost (WifiServiceImpl.acquireWifiLock enforces WAKE_LOCK) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS" />
    <!-- UDC mask (UdcMask.java): both plain "signature" -> platform cert grants them, no
         privapp-permissions entry needed. CAMERA_OPEN_CLOSE_LISTENER makes cameraserver deliver
         onCameraOpened(cameraId, package); INTERNAL_SYSTEM_WINDOW allows TYPE_SECURE_SYSTEM_OVERLAY. -->
    <uses-permission android:name="android.permission.CAMERA_OPEN_CLOSE_LISTENER" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Desktop integration (see DesktopIntegration.java).
         NOTE: the platform certificate is NOT sufficient on its own. This app is privileged
         (/system_ext/priv-app), and signature|privileged permissions ALSO require an entry in
         permissions/privapp-permissions-com.nubia.rmcontrol.xml. Without it,
         PackageManagerService.systemReady() throws under ro.control_privapp_permissions=enforce
         and the device boot-loops. MANAGE_APP_OPS_MODES is plain signature and needs no entry.
         MANAGE_APP_OPS_MODES  - pre-grant MagicDesk's display-over-apps op
         CHANGE_OVERLAY_PACKAGES + INTERACT_ACROSS_USERS - toggle the on-device desktop RRO -->
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <!-- signature perm (platform-signed grants it); lets the app set the external
         display's user-preferred mode for the fixed refresh-rate selector -->
    <uses-permission android:name="android.permission.MODIFY_USER_PREFERRED_DISPLAY_MODE" />
    <!-- Remote Key Provisioning toggle (Rkp.java).
         WRITE_DEVICE_CONFIG is plain "signature" (not signature|privileged), so the platform
         certificate alone grants it and NO privapp-permissions entry is required.
         KILL_BACKGROUND_PROCESSES is "normal". Both were chosen precisely to avoid touching
         privapp-permissions, where a missing entry boot-loops the device. -->
    <uses-permission android:name="android.permission.WRITE_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Privacy guard (PrivacyGuard.java).
         WATCH_APPOPS is signature|privileged -> it IS listed in
         permissions/privapp-permissions-com.nubia.rmcontrol.xml (missing entry = boot-loop).
         It delivers the rejected camera/mic/location attempts for the "Allow for 10 min"
         notification. The blocking itself needs nothing here: the rules go to
         Settings.Secure rm_privacy_guard (WRITE_SECURE_SETTINGS above) and the
         PermissionPolicyService patch in frameworks/base enforces them.
         POST_NOTIFICATIONS: runtime; self-granted at start with GRANT_RUNTIME_PERMISSIONS
         (signature|installer|verifier -> platform cert, no allowlist entry). The same grant
         permission hands RECORD_AUDIO/POST_NOTIFICATIONS to the VoIP call recorder engine
         when its switch in this app is turned on. -->
    <uses-permission android:name="android.permission.WATCH_APPOPS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <!-- OTP-in-SMS copy helper: read incoming SMS to detect one-time codes (self-granted) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".RmApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:persistent="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Settings screen -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tiles -->
        <service
            android:name=".LoudnessTile"
            android:label="@string/tile_loudness"
            android:icon="@drawable/ic_loudness"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".FpWakeTile"
            android:label="@string/tile_fpwake"
            android:icon="@drawable/ic_fingerprint"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".Dt2wTile"
            android:label="@string/tile_dt2w"
            android:icon="@drawable/ic_dt2w"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service android:name=".FanTile" android:label="@string/tile_fan" android:icon="@drawable/ic_fan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".CoolingTile" android:label="@string/tile_cooling" android:icon="@drawable/ic_cooling"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- Phone-as-touchpad for an external display (TouchpadActivity). Black, full screen,
             portrait-locked so the pointer axes do not flip when the phone is held sideways. -->
        <activity
            android:name=".TouchpadActivity"
            android:label="@string/touchpad_title"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <service android:name=".TouchpadTile" android:label="@string/tile_touchpad" android:icon="@drawable/ic_touchpad"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- Phone screen off, external display stays on (three-finger tap in touchpad mode or QS tile). -->
        <service android:name=".MonitorOnlyService" android:exported="false" />
        <service android:name=".MonitorOnlyTile" android:label="@string/tile_monitor_only" android:icon="@drawable/ic_monitor_only"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- Privacy guard: per-app camera / mic / location block the app cannot detect. -->
        <service android:name=".PrivacyTile" android:label="@string/tile_privacy" android:icon="@drawable/ic_privacy"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <receiver android:name=".PrivacyGuardReceiver" android:exported="false" />
        <receiver android:name=".OtpSmsReceiver" android:exported="true"
                android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="900">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <!-- PackageGuardReceiver (auto-guard new installs) is registered at runtime from
             PrivacyGuard.start(): a manifest receiver never gets the implicit PACKAGE_ADDED. -->
        <receiver android:name=".OtpCopyReceiver" android:exported="false">
            <intent-filter><action android:name="com.nubia.rmcontrol.OTP_COPY" /></intent-filter>
        </receiver>
    </application>
</manifest>
