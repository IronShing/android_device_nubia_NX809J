<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nubia.rmcontrol"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- WAKE_LOCK (normal perm): required to hold a WifiLock for the game-mode
         max-wifi boost (WifiServiceImpl.acquireWifiLock enforces WAKE_LOCK) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Desktop integration (see DesktopIntegration.java).
         NOTE: the platform certificate is NOT sufficient on its own. This app is privileged
         (/system_ext/priv-app), and signature|privileged permissions ALSO require an entry in
         permissions/privapp-permissions-com.nubia.rmcontrol.xml. Without it,
         PackageManagerService.systemReady() throws under ro.control_privapp_permissions=enforce
         and the device boot-loops. MANAGE_APP_OPS_MODES is plain signature and needs no entry.
         MANAGE_APP_OPS_MODES  - pre-grant MagicDesk's display-over-apps op
         CHANGE_OVERLAY_PACKAGES + INTERACT_ACROSS_USERS - toggle the on-device desktop RRO -->
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <!-- signature perm (platform-signed grants it); lets the app set the external
         display's user-preferred mode for the fixed refresh-rate selector -->
    <uses-permission android:name="android.permission.MODIFY_USER_PREFERRED_DISPLAY_MODE" />
    <!-- Remote Key Provisioning toggle (Rkp.java).
         WRITE_DEVICE_CONFIG is plain "signature" (not signature|privileged), so the platform
         certificate alone grants it and NO privapp-permissions entry is required.
         KILL_BACKGROUND_PROCESSES is "normal". Both were chosen precisely to avoid touching
         privapp-permissions, where a missing entry boot-loops the device. -->
    <uses-permission android:name="android.permission.WRITE_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:name=".RmApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:persistent="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Settings screen -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tiles -->
        <service
            android:name=".LoudnessTile"
            android:label="@string/tile_loudness"
            android:icon="@drawable/ic_loudness"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".FpWakeTile"
            android:label="@string/tile_fpwake"
            android:icon="@drawable/ic_fingerprint"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".Dt2wTile"
            android:label="@string/tile_dt2w"
            android:icon="@drawable/ic_dt2w"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service android:name=".FanTile" android:label="@string/tile_fan" android:icon="@drawable/ic_fan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".CoolingTile" android:label="@string/tile_cooling" android:icon="@drawable/ic_cooling"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
    </application>
</manifest>
