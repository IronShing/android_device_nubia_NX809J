# dt2w_uewake — odm double-tap-to-wake bridge daemon (started by init from
# /odm/etc/init/dt2w_uewake.rc).
#
# It pokes /proc/touchscreen (the stock-vendor syna_proc type), /dev/uinput, and
# a netlink kobject-uevent socket. syna_proc is a stock-vendor-PRIVATE type that
# is not present in our buildable policy sources, so we cannot write explicit
# allow rules against it from odm. Mark the domain permissive instead of
# referencing a type we don't own. (Revisit if the touch node is relabelled to a
# plat/odm type we control, then drop permissive and add explicit rules.)
#
# NOTE: permissive domains are rejected in -user builds; this is fine for the
# current -userdebug target but must be resolved before a -user release.
type dt2w_uewake, domain;
type dt2w_uewake_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(dt2w_uewake)
permissive dt2w_uewake;
