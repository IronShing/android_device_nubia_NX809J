# NX809J device-specific (odm) file contexts.
#
# NOTE: /sys and /proc nodes are labelled in genfs_contexts — file_contexts is
# silently ignored for sysfs/proc. Stock /vendor binaries are labelled by the
# stock vendor policy and odm cannot relabel them, so there are no /vendor
# entries here (the previous /vendor relabels were dead: our vendor policy is
# never flashed).

# DT2W uewake bridge daemon (odm)
/odm/bin/dt2w_uewake                                    u:object_r:dt2w_uewake_exec:s0

# Logdump partition (block device — file_contexts is valid for /dev)
/dev/block/bootdevice/by-name/logdump                  u:object_r:logdump_block_device:s0
