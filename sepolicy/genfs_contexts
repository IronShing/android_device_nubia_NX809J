# NX809J device-specific genfs (sysfs/proc) labels.
#
# file_contexts is SILENTLY IGNORED for sysfs and proc nodes — they must be
# labelled here via genfscon or they keep their generic sysfs/proc label and the
# matching allow rules are dead. These are net-new ZTE nodes (the stock vendor
# policy does not genfscon them, so there is no conflicting entry). Do NOT add
# /proc/touchscreen here — the stock vendor policy already labels it syna_proc.

# Fan control (fan_enable, fan_speed_level/pwm/count)
genfscon sysfs /kernel/fan                      u:object_r:sysfs_fan:s0

# RGB LED (aw22xxx)
genfscon sysfs /class/leds/aw22xxx_led          u:object_r:sysfs_leds_aw22xxx:s0

# Shoulder-trigger SAR sensors (Awinic)
genfscon sysfs /class/leds/sar0                 u:object_r:sysfs_sar_trigger:s0
genfscon sysfs /class/leds/sar1                 u:object_r:sysfs_sar_trigger:s0

# Haptic engine (sysfs_vibrator is a plat type)
genfscon sysfs /class/leds/zte_vibrator         u:object_r:sysfs_vibrator:s0

# Micropump / liquid cooling
genfscon proc /driver/micropump                 u:object_r:proc_micropump:s0
