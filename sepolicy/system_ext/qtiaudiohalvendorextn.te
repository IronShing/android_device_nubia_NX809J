# QTI audio HAL vendor-parameter parser (IHalAdapterVendorExtension), built into
# system_ext so it runs in a clean coredomain under enforcing — same approach as
# hal_lineage_health_default + dt2w_uewake.
#
# WHY IT EXISTS: Android 16's AIDL audio HAL delegates legacy string setParameters
# ("call_state=2;vsid=...;call_type=LTE") to the system_ext service
# android.media.audio.IHalAdapterVendorExtension/default, which translates them into
# structured VendorParameters. Without this service those params are dropped, the
# modem voice session never opens, and VoLTE calls connect but are SILENT. The fix
# (device.mk) builds qtiaudiohalvendorextn + sets ro.audio.ihaladaptervendorextension_enabled=true.
#
# The binary is a cc_binary at /system_ext/bin/qtiaudiohalvendorextn (class hal,
# user system) from vendor/qcom/opensource/commonsys/audio/hal_adapter.
#
# Modeled on the QTI reference device/qcom/sepolicy/generic/private/qtiaudiohalvendorextn.te,
# but with a LOCALLY-defined service type: LOS core sepolicy has neither QTI's
# vendor_audioserver_service nor an AOSP audio_vendor_parameter_parser_service type,
# and audioserver_service is neverallow-locked to the audioserver domain only.
#
# ENFORCING VALIDATION: device boots permissive (qmipriod blocks a global flip — see
# BoardConfig), but AVCs are still LOGGED under permissive. After a VoLTE call, grep
# dmesg/logcat for `avc: denied .* (vendor_qtiaudiohalvendorextn|audio_vendor_parameter_parser_service)`
# — none = this domain is enforcing-ready. Add allows here for any that appear.

type vendor_qtiaudiohalvendorextn, domain, coredomain;
type vendor_qtiaudiohalvendorextn_exec, system_file_type, exec_type, file_type;

# Dedicated service_manager type for the parser (AOSP-16 ships no core type for it).
type audio_vendor_parameter_parser_service, service_manager_type;

# init launches it (class hal) -> transition into its own domain.
init_daemon_domain(vendor_qtiaudiohalvendorextn)
binder_use(vendor_qtiaudiohalvendorextn)

# The parser registers android.media.audio.IHalAdapterVendorExtension/default.
allow vendor_qtiaudiohalvendorextn audio_vendor_parameter_parser_service:service_manager { add find };

# audioserver discovers the parser and binder-calls it to translate setParameters().
allow audioserver audio_vendor_parameter_parser_service:service_manager find;
binder_call(audioserver, vendor_qtiaudiohalvendorextn)
