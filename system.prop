# TODO: Populate from system/build.prop after extraction

# --- A17 SPIKE: debug build only. NEVER ship. ---
# /system/build.prop is loaded BEFORE /vendor/build.prop and ro.* props are
# first-writer-wins, so setting these here also wins if this build is flashed over a
# STOCK or hybrid /vendor (whose vendor.prop we do not control).
ro.adb.secure=0
persist.sys.usb.config=adb
# Fold the kernel ring buffer into logcat so a vendor/HAL crash and its kernel context
# land in one timeline, and persist logs across a bootloop.
ro.logd.kernel=true
persist.logd.logpersistd=logcatd
persist.logd.logpersistd.size=64
