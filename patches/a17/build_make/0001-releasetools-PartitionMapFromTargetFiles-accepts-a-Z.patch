From 6aeb11b163bf5a43c35a8ae09efbdd1ba2905aac Mon Sep 17 00:00:00 2001
From: John <john@primaryautotrd.com>
Date: Thu, 1 Oct 2026 23:19:00 +0300
Subject: [PATCH] releasetools: PartitionMapFromTargetFiles accepts a ZipFile
 (NX809J/A17 signing)

_ReadPartitionPropFile() passes the still-zipped input, so os.path.join() raised
TypeError and no A17 target-files zip could be signed. Accept both forms.
---
 tools/releasetools/common.py | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/tools/releasetools/common.py b/tools/releasetools/common.py
index da81f106f9..79bd03889e 100644
--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -1388,10 +1388,21 @@ def PartitionMapFromTargetFiles(target_files_dir):
       "odm_dlkm": ["ODM_DLKM", "VENDOR/odm_dlkm", "SYSTEM/vendor/odm_dlkm"],
       "system_dlkm": ["SYSTEM_DLKM", "SYSTEM/system_dlkm"],
   }
+  # NX809J/A17: written for an EXTRACTED target-files dir, but _ReadPartitionPropFile()
+  # passes the still-zipped input (a ZipFile), so os.path.join() raises TypeError and no
+  # A17 target-files zip can be signed at all. Accept both forms.
+  if isinstance(target_files_dir, zipfile.ZipFile):
+    _names = target_files_dir.namelist()
+    def _has(subdir):
+      return any(n.startswith(subdir + '/') for n in _names)
+  else:
+    def _has(subdir):
+      return os.path.exists(os.path.join(target_files_dir, subdir))
+
   partition_map = {}
   for partition, subdirs in possible_subdirs.items():
     for subdir in subdirs:
-      if os.path.exists(os.path.join(target_files_dir, subdir)):
+      if _has(subdir):
         partition_map[partition] = subdir
         break
   return partition_map
-- 
