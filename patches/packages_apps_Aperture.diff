+                linearZoom.coerceAtMost(maxLinear.coerceIn(0f, 1f))
+            } else {
+                linearZoom
+            }
+            viewModel.cameraController.setLinearZoom(clamped)
         }
         zoomLevel.textFormatter = {
             "%.1fx".format(viewModel.zoomState.value?.zoomRatio)
