From 02fec27a19ab83259634b780c193f22798b323dc Mon Sep 17 00:00:00 2001
From: John <john@primaryautotrd.com>
Date: Tue, 4 Aug 2026 15:00:30 +0300
Subject: [PATCH] Dialer: automatic call recording (all regions) for NX809J

- CallRecorder.canRecordInCurrentCountry() -> returns isEnabled() so recording is
  available in all regions (was RECORD_ALLOWED_STATE_BY_COUNTRY gated).
- CallButtonPresenter.onStateChange(INCALL): maybeAutoStartRecording() auto-starts
  recording when call goes active, gated on a new "call_recording_auto" pref
  (default on) + canRecord + hasAllPermissions.
- sound_settings.xml: "Auto-record calls" SwitchPreference; cm_strings: its title/summary.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XSVqjLdTXp7prKh1VGn7kD
Change-Id: I5b8110745e87e60b8ef2593f813ac23e16a66e1a
---
 .../dialer/app/res/values/cm_strings.xml      |  2 ++
 .../dialer/app/res/xml/sound_settings.xml     |  7 ++++++
 .../android/incallui/CallButtonPresenter.java | 25 +++++++++++++++++++
 .../android/incallui/call/CallRecorder.java   | 14 +++--------
 4 files changed, 37 insertions(+), 11 deletions(-)

diff --git a/java/com/android/dialer/app/res/values/cm_strings.xml b/java/com/android/dialer/app/res/values/cm_strings.xml
index 79dee54d6..00dda53d2 100644
--- a/java/com/android/dialer/app/res/values/cm_strings.xml
+++ b/java/com/android/dialer/app/res/values/cm_strings.xml
@@ -34,6 +34,8 @@
 
     <string name="call_recording_category_key" translatable="false">call_recording_category</string>
     <string name="call_recording_category_title">Call recording</string>
+    <string name="call_recording_auto_title">Auto-record calls</string>
+    <string name="call_recording_auto_summary">Automatically start recording when a call begins</string>
     <string name="call_recording_format_key" translatable="false">call_recording_format</string>
     <string name="call_recording_format">Audio format</string>
     <string name="wb_amr_format" translatable="false">AMR-WB</string>
diff --git a/java/com/android/dialer/app/res/xml/sound_settings.xml b/java/com/android/dialer/app/res/xml/sound_settings.xml
index 86f928486..b357f5ac9 100644
--- a/java/com/android/dialer/app/res/xml/sound_settings.xml
+++ b/java/com/android/dialer/app/res/xml/sound_settings.xml
@@ -82,6 +82,13 @@
         android:title="@string/call_recording_category_title"
         app:iconSpaceReserved="false">
 
+        <SwitchPreference
+            android:defaultValue="true"
+            android:key="call_recording_auto"
+            android:summary="@string/call_recording_auto_summary"
+            android:title="@string/call_recording_auto_title"
+            app:iconSpaceReserved="false" />
+
         <ListPreference
             android:defaultValue="0"
             android:entries="@array/call_recording_encoder_entries"
diff --git a/java/com/android/incallui/CallButtonPresenter.java b/java/com/android/incallui/CallButtonPresenter.java
index 8da3b2049..989e40342 100644
--- a/java/com/android/incallui/CallButtonPresenter.java
+++ b/java/com/android/incallui/CallButtonPresenter.java
@@ -70,6 +70,8 @@ public class CallButtonPresenter
         DialerCallListener {
 
   private static final String KEY_RECORDING_WARNING_PRESENTED = "recording_warning_presented";
+  // NX809J: auto call recording preference key (default on).
+  private static final String PREF_AUTO_RECORD_CALLS = "call_recording_auto";
 
   private final Context context;
   private InCallButtonUi inCallButtonUi;
@@ -153,6 +155,7 @@ public class CallButtonPresenter
       call = callList.getOutgoingCall();
     } else if (newState == InCallState.INCALL) {
       call = callList.getActiveOrBackgroundCall();
+      maybeAutoStartRecording();
 
       // When connected to voice mail, automatically shows the dialpad.
       // (On previous releases we showed it when in-call shows up, before waiting for
@@ -334,6 +337,28 @@ public class CallButtonPresenter
     }
   }
 
+  /**
+   * NX809J: auto call recording — start recording automatically as soon as a call becomes
+   * active, when the "Auto-record calls" setting is on (default) and recording is possible.
+   * Skips silently if permissions aren't granted (no mid-call dialog).
+   */
+  private void maybeAutoStartRecording() {
+    if (call == null || context == null) {
+      return;
+    }
+    boolean autoRecord = PreferenceManager.getDefaultSharedPreferences(context)
+        .getBoolean(PREF_AUTO_RECORD_CALLS, true);
+    if (!autoRecord) {
+      return;
+    }
+    CallRecorder recorder = CallRecorder.getInstance();
+    if (recorder.canRecordInCurrentCountry()
+        && !recorder.isRecording()
+        && hasAllPermissions(CallRecorder.REQUIRED_PERMISSIONS)) {
+      recorder.startRecording(call.getNumber(), call.getCreationTimeMillis());
+    }
+  }
+
   private boolean hasAllPermissions(String[] permissions) {
     for (String p : permissions) {
       if (context.checkSelfPermission(p) != PackageManager.PERMISSION_GRANTED) {
diff --git a/java/com/android/incallui/call/CallRecorder.java b/java/com/android/incallui/call/CallRecorder.java
index 8388d75c4..c70e62fff 100644
--- a/java/com/android/incallui/call/CallRecorder.java
+++ b/java/com/android/incallui/call/CallRecorder.java
@@ -93,17 +93,9 @@ public class CallRecorder implements CallList.Listener {
   }
 
   public boolean canRecordInCurrentCountry() {
-      if (!isEnabled()) {
-          return false;
-      }
-      if (RECORD_ALLOWED_STATE_BY_COUNTRY.isEmpty()) {
-          loadAllowedStates();
-      }
-
-      String currentCountryIso = GeoUtil.getCurrentCountryIso(context);
-      Boolean allowedState = RECORD_ALLOWED_STATE_BY_COUNTRY.get(currentCountryIso);
-
-      return allowedState != null && allowedState;
+      // NX809J: call recording opened for ALL countries
+      // (dropped the RECORD_ALLOWED_STATE_BY_COUNTRY allow-list gate).
+      return isEnabled();
   }
 
   private CallRecorder() {
