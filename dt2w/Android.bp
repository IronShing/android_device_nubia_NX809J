// NX809J double-tap-to-wake uevent->KEY_WAKEUP bridge
cc_binary {
    name: "dt2w_uewake",
    srcs: ["dt2w_uewake.c"],
    shared_libs: ["liblog"],
    cflags: ["-Wall", "-Werror"],
    init_rc: ["dt2w_uewake.rc"],
    // odm, not system_ext: the daemon pokes /proc/touchscreen (vendor-labelled
    // syna_proc) and /dev/uinput, which a coredomain cannot reference under
    // enforcing SELinux. /vendor is the stock partition (not built here), so odm
    // is the device-specific home — matching init.NX809J.rc (also on odm).
    device_specific: true,
}
