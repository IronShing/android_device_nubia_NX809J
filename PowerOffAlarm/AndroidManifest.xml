<?xml version="1.0" encoding="utf-8"?>
<!-- Package name is load-bearing: seapp_contexts (vendor_qti_poweroffalarm_app) and
     DeskClock's intent.setPackage() both key on com.qualcomm.qti.poweroffalarm. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qualcomm.qti.poweroffalarm">

    <!-- Same permission the stock app declares; DeskClock asks for it at runtime
         (dangerous), and the receiver below is guarded by it. -->
    <permission
        android:name="org.codeaurora.permission.POWER_OFF_ALARM"
        android:label="@string/perm_label"
        android:description="@string/perm_desc"
        android:protectionLevel="dangerous" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <receiver
            android:name=".PowerOffAlarmReceiver"
            android:permission="org.codeaurora.permission.POWER_OFF_ALARM"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.codeaurora.poweroffalarm.action.SET_ALARM" />
                <action android:name="org.codeaurora.poweroffalarm.action.CANCEL_ALARM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
