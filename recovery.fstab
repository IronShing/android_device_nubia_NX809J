# Verified against NX809J V11.0.14MR4_EA extraction

# mount point    fs type     device                                  flags
/boot            emmc        /dev/block/bootdevice/by-name/boot      flags=slotselect
/init_boot       emmc        /dev/block/bootdevice/by-name/init_boot flags=slotselect
/vendor_boot     emmc        /dev/block/bootdevice/by-name/vendor_boot flags=slotselect
/dtbo            emmc        /dev/block/bootdevice/by-name/dtbo      flags=slotselect;backup=1
/recovery        emmc        /dev/block/bootdevice/by-name/recovery  flags=slotselect;backup=1
/vbmeta          emmc        /dev/block/bootdevice/by-name/vbmeta    flags=slotselect
/vbmeta_system   emmc        /dev/block/bootdevice/by-name/vbmeta_system flags=slotselect

/data            f2fs        /dev/block/bootdevice/by-name/userdata  flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption
/metadata        f2fs        /dev/block/by-name/metadata             flags=backup=1
/misc            emmc        /dev/block/bootdevice/by-name/misc
/persist         ext4        /dev/block/bootdevice/by-name/persist   flags=backup=1;display="Persist"

# Dynamic partitions (mounted via device-mapper in recovery)
system           /system     erofs       flags=slotselect;display="System"
system_ext       /system_ext erofs       flags=slotselect;display="System EXT"
product          /product    erofs       flags=slotselect;display="Product"
vendor           /vendor     erofs       flags=slotselect;display="Vendor"
vendor_dlkm      /vendor_dlkm erofs     flags=slotselect;display="Vendor DLKM"
odm              /odm        erofs       flags=slotselect;display="ODM"
system_dlkm      /system_dlkm erofs     flags=slotselect;display="System DLKM"

# Firmware / backup partitions
/efisp           emmc        /dev/block/bootdevice/by-name/efisp     flags=backup=1;display="EFISP"
/firmware        vfat        /dev/block/bootdevice/by-name/modem     flags=slotselect;display="Firmware";mounttowait
/bt_firmware     vfat        /dev/block/bootdevice/by-name/bluetooth flags=slotselect;display="Bluetooth"
