<resources>
    <!-- Display -->
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">128</integer>
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Under-display camera (UDC) — reserve status bar area -->
    <dimen name="status_bar_height_portrait">48dp</dimen>

    <!-- Fingerprint (3D ultrasonic under-display) -->
    <bool name="config_supportScreenIdleLock">true</bool>

    <!-- Gestures: double-tap-to-wake (Synaptics TCM touch supports gesture wake) -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- Doze / Always-On Display. The stock BOE rm692h5 panel supports AOD
         (zte,aod_enabled in its DT) and the vendor.qti.hardware.display.ztedisp
         HAL drives AOD backlight (updateAodBacklight). AOSP defaults leave
         config_dozeComponent empty and config_dozeAlwaysOnDisplayAvailable=false,
         so the doze_always_on setting does nothing. Wire the SystemUI doze
         service and declare AOD available + on-by-default. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">true</bool>
    <!-- AOD doze brightness. AOSP default config_screenBrightnessDozeFloat=0.0
         (off) renders AOD nearly black. Set a dim-but-visible value; tune if the
         panel shows it too dark/bright. -->
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.2</item>
    <integer name="config_screenBrightnessDoze">51</integer>

    <!-- NFC -->
    <bool name="config_nfc_hw_capability">true</bool>

    <!-- WiFi -->
    <bool name="config_wifi_dual_band_support">true</bool>
    <integer name="config_wifi_framework_scan_interval">10000</integer>

    <!-- Telephony -->
    <bool name="config_voice_capable">true</bool>
    <bool name="config_sms_capable">true</bool>
    <!-- SIM hot-swap. The RIL/modem detects insert/remove correctly (CARDSTATE_PRESENT/ABSENT
         + iccid read fire, num_apps=1 on re-insert), but AOSP defaults config_hotswapCapable=false,
         so UiccSlot.onIccSwap() prompts a REBOOT instead of completing the SIM-ready→subscription→
         registration flow → calls dead until reboot. Stock RedMagicOS sets it true. Diagnosed live
         2026-06-22 (log: "onIccSwap: isHotSwapSupported is false, prompt for rebooting" on both the
         remove AND the re-insert). Setting true = framework hot-swaps the SIM with no reboot. -->
    <bool name="config_hotswapCapable">true</bool>

    <!-- USB -->
    <bool name="config_hasUsbAccessory">true</bool>

    <!-- Battery (7500mAh) -->
    <integer name="config_criticalBatteryWarningLevel">5</integer>
    <integer name="config_lowBatteryWarningLevel">15</integer>

    <!-- Desktop mode (Android 16 desktop windowing: external-display + on-device freeform).
         Pairs with the enable_desktop_windowing_mode aconfig override (build/release/aconfig/bp4a)
         and the freeform_window_management feature in device.mk. -->
    <bool name="config_isDesktopModeSupported">true</bool>
    <!-- FALSE on purpose: this is what removes the white "app handle" pill that Android 16
         draws at the top centre of every fullscreen app (reported on XDA as an undismissable
         white bar). The pill is desktop-windowing task decor, not a status bar element - it
         survives a SystemUI restart, ignores every status bar setting, and there is NO runtime
         way to switch it off on this build (show_desktop_experience_dev_option is baked
         enabled, and that code path can only return OVERRIDE_ON or OVERRIDE_UNSET - never OFF).

         Path that matters (AppHandleAndHeaderVisibilityHelper):
           shouldShowAppHandleOrHeader = allowedForTask() && allowedForDisplay()
             ^ the && allowedForDisplay() applies because enable_projected_display_desktop_mode
               is baked enabled in this build
           allowedForDisplay(internal) -> DesktopModeStatus.isDesktopModeSupportedOnDisplay()
             -> enforceDeviceRestrictions() is true (sysprop unset, defaults true)
             -> display.getType()==TYPE_INTERNAL -> returns THIS bool
           then falls through to a large-screen check, which fails here
           (minSizeDimensionDp = 374dp < LARGE_SCREEN_SMALLEST_SCREEN_WIDTH_DP = 600).
         So false here => allowedForDisplay() false => no handle.

         NOTE: this bool is *short-circuited* inside canEnterDesktopMode() by the projected-display
         flag, so reasoning from that function alone suggests (wrongly) that it has no effect.
         allowedForDisplay() is the gate that actually consumes it.

         Cost: no on-device freeform/desktop on the phone screen. External/projected displays are
         unaffected (they take the isDisplayInTopology / isEligibleForDesktopMode path).
         Set back to true to restore on-device desktop mode - and the pill with it. -->
    <bool name="config_canInternalDisplayHostDesktops">false</bool>
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>

    <!-- Auto-brightness curve. config_automatic_brightness_available is true and the
         stk3a7x light sensor works, but neither the DDC XML (/vendor/etc/displayconfig/
         display_id_*.xml has <screenBrightnessMap> but NO <autoBrightness> block) nor
         this overlay supplied a lux->brightness curve, so DisplayPowerController showed
         mBrightnessLevelsMap={} / mLightSensor=null and auto-brightness did nothing.
         This is the nits-based curve (device uses DDC nits mapping); nits stay within the
         panel range 0.2289..782.43. config_autoBrightnessDisplayValuesNits must be exactly
         one entry LONGER than config_autoBrightnessLevels (N lux levels -> N+1 nits). -->
    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>3</item>
        <item>8</item>
        <item>15</item>
        <item>30</item>
        <item>60</item>
        <item>120</item>
        <item>240</item>
        <item>500</item>
        <item>1000</item>
        <item>2500</item>
        <item>6000</item>
    </integer-array>
    <array name="config_autoBrightnessDisplayValuesNits">
        <item>2.0</item>
        <item>5.0</item>
        <item>10.0</item>
        <item>18.0</item>
        <item>30.0</item>
        <item>50.0</item>
        <item>80.0</item>
        <item>130.0</item>
        <item>200.0</item>
        <item>300.0</item>
        <item>430.0</item>
        <item>600.0</item>
        <item>780.0</item>
    </array>
    <!-- 144Hz: default peak + min refresh so the panel runs at its max -->
    <integer name="config_defaultPeakRefreshRate">144</integer>
    <integer name="config_defaultRefreshRate">144</integer>

    <!-- Power menu. AOSP already implements the logout action end-to-end (GlobalActionsDialogLite
         LogoutAction -> UserLogoutInteractor.logOut(), which kills the current user's processes and
         returns to the owner's lock screen) but "logout" is simply absent from the default
         config_globalActionsList, so it can never appear. Requested on XDA (#247) by a heavy
         multi-user user. Adding it is safe for single-user devices: the entry is gated at runtime on
         mLogoutInteractor.isLogoutEnabled(), which is false unless multi-user logout is actually
         available (DevicePolicyManager.setLogoutEnabled / secondary user present), so nothing new
         shows up for everyone else. This list is otherwise the AOSP default - EvolutionX does not
         customise it, so no entries are lost by overriding here. -->
    <string-array translatable="false" name="config_globalActionsList">
        <item>emergency</item>
        <item>lockdown</item>
        <item>power</item>
        <item>restart</item>
        <item>screenshot</item>
        <item>bugreport</item>
        <item>logout</item>
    </string-array>

    <!-- Android Auto (2026-09-02). Minimal and microG do not get the Pixel RRO
         GoogleConfigOverlay (WITH_GMS=true only), which is what makes gearhead the
         SYSTEM_AUTOMOTIVE_PROJECTION role holder on Full. Without a holder the role is empty and
         Android Auto cannot project even when installed. The role is systemOnly, so this only
         takes effect together with the preinstalled AndroidAutoStubPrebuilt from android_auto.mk.
         Listener access mirrors PixelConfigOverlayCommon so AA can read notifications/messages
         without the user hunting for the toggle. Full keeps its RRO values (RRO wins at runtime),
         which name the same package. -->
    <string name="config_systemAutomotiveProjection" translatable="false">com.google.android.projection.gearhead</string>

    <!-- External display default UI size. AOSP derives it from the monitor's physical ppi so a
         48 dp touch target is 10.4 mm: 111 dpi on a 27" 1080p monitor, everything ~0.7x and
         unreadable. 160 at 1080p (213 at 1440p, 320 at 4K) matches DeX / Chrome OS; still
         adjustable per monitor in Settings > Connected devices > External displays > Display size. -->
    <integer name="config_externalDisplayBaseDensityAt1080p">160</integer>
    <string name="config_defaultListenerAccessPackages" translatable="false">com.google.android.projection.gearhead</string>
</resources>
