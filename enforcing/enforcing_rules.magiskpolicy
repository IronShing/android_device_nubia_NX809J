# NX809J enforcing candidate rules (magiskpolicy --live format)
# generated from live permissive denials; camera prop-flood collapsed to property_type
allow adbroot adbroot capability { dac_read_search }
allow bootanim vendor_hal_qspmhal_default binder { call }
allow camerahalvs default_prop property_service { set }
allow camerahalvs property_type file { getattr map open read }
allow camerahalvs shell_data_file dir { search }
allow camerahalvs system_data_file dir { search }
allow extra_free_kbytes extra_free_kbytes capability { dac_read_search }
allow fsck fsck capability { dac_read_search }
allow gsid gsid capability { dac_read_search }
allow hal_audio_default property_type file { getattr map open read }
allow hal_bootctl_default block_device blk_file { getattr }
allow hal_bootctl_default hal_bootctl_default capability { dac_read_search }
allow hal_camera_default property_type file { getattr map open read }
allow hal_camera_default shell_data_file dir { search }
allow hal_camera_default system_data_file dir { search }
allow hal_camera_default vendor_confqmaa file { getattr map open }
allow hal_camera_default vendor_media_performance_class file { getattr map open }
allow hal_camera_default vendor_memory_min_free_kbytes file { getattr open }
allow hal_nfc_default property_type file { getattr map open read }
allow hal_sensors_default sysfs dir { open read }
allow hal_thermal_default hal_thermal_default capability { dac_read_search }
allow init debugfs_bootreceiver_tracing dir { add_name write }
allow init proc_pid_max file { getattr open read }
allow init same_process_hal_file file { execute }
allow init sysfs file { open write }
allow init vendor_file file { execute_no_trans }
allow kcmdlinectrl kcmdlinectrl capability { dac_read_search }
allow kernel device blk_file { create setattr }
allow kernel device chr_file { create getattr setattr unlink }
allow kernel device dir { add_name create remove_name write }
allow mediacodec sysfs dir { open read }
allow misctrl misctrl capability { dac_read_search }
allow netutils_wrapper netutils_wrapper capability { dac_read_search }
allow nfc vendor_nfc_vendor_data_file dir { search }
allow profcollectd profcollectd capability { dac_read_search }
allow remount remount capability { dac_read_search }
allow servicemanager hal_vibrator_default binder { call }
allow servicemanager vendor_hal_poweroptservice_qti binder { call }
allow servicemanager vendor_location binder { call }
allow surfaceflinger vendor_hal_qspmhal_default binder { call }
allow system_server sysfs file { getattr open read }
allow system_server vendor_file file { getattr }
allow tee device chr_file { ioctl open read write }
allow tee tee capability { dac_read_search }
allow variantidBin variantidBin capability { dac_read_search }
allow vdc vdc capability { dac_read_search }
allow vendor_aimodel_default sysfs dir { open read }
