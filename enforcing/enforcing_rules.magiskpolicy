allow vendor_hal_perf_default property_type file { getattr map open read }
allow vendor_hal_poweroptservice_qti property_type file { getattr map open read }
allow vendor_hal_poweroptservice_qti sysfs_usbscript dir { search }
allow vendor_hal_poweroptservice_qti sysfs_usbscript file { open read }
allow vendor_init bluetooth_prop property_service { set }
allow vendor_init build_prop property_service { set }
allow vendor_init cgroup file { getattr }
allow vendor_init config_prop property_service { set }
allow vendor_init property_type file { read }
allow vendor_init radio_prop property_service { set }
allow vendor_init shell_data_file dir { setattr }
allow vendor_init sysfs lnk_file { setattr }
allow vendor_init vendor_display_notch_prop property_service { set }
allow vendor_init vendor_rawdump_block_device lnk_file { setattr }
allow vendor_irsc_util vendor_irsc_util capability { dac_read_search }
allow vendor_location servicemanager binder { call transfer }
