<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest — ZTE Nubia RedMagic 11 Pro (NX809J) on LineageOS 23.2.
  Canonical copy; the live one lives at .repo/local_manifests/nx809j.xml.

  Reproduce a buildable tree from scratch:
    repo init -u https://github.com/LineageOS/android.git -b lineage-23.2
    mkdir -p .repo/local_manifests
    cp device/nubia/NX809J/manifest/nx809j.xml .repo/local_manifests/   # (or curl the raw URL)
    repo sync -j8
    bash device/nubia/NX809J/patches/apply-patches.sh    # out-of-tree fixes (see below)
    source build/envsetup.sh && unset -f grep
    lunch lineage_NX809J-bp4a-userdebug && m

  The three IronShing projects below are device-specific. Fixes to the SHARED LOS/AOSP
  repos (frameworks/base, vendor/lineage, packages/apps/CarrierConfig) are carried as
  git patches in device/nubia/NX809J/patches/ and applied by apply-patches.sh — so
  those repos stay upstream and need no fork. Prefer forks? Uncomment the block at the
  bottom and push the matching branches (see patches/README.md).
-->
<manifest>
  <!-- Device tree (sepolicy, init, overlays, IMS graft, the patches/ + this manifest) -->
  <project name="IronShing/android_device_nubia_NX809J"
           path="device/nubia/NX809J" remote="github" revision="lineage-23" />

  <!-- Prebuilt stock GKI kernel Image + stock DTBO (we ride the prebuilt kernel) -->
  <project name="IronShing/android_kernel_nubia_NX809J"
           path="device/nubia/NX809J-kernel" remote="github" revision="lineage-23" />

  <!-- Vendor: extracted proprietary blobs (device rides the stock /vendor partition) -->
  <project name="IronShing/android_vendor_nubia_NX809J"
           path="vendor/nubia/NX809J" remote="github" revision="lineage-23" />


  <!-- Display: swap LineageOS sm8750 display for the OnePlus-SM8850-Development
       sm8850 source (composer3-V4 / config-V13 / aiqe-V3 = version-matched to the
       NX809J stock display blobs; the sm8750 source only had composer3-V1/aiqe-V2).
       Pulled to the sm8750/display path so the device's existing sm8750 display
       namespace + wiring is reused. NX809J port fixes (SetupAtomic bounds, header
       wiring, libvmmem, namespace) are applied by patches/display_sm8850/ via
       apply-patches.sh. See patches/display_sm8850/README.md. -->
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-core" />
  <project name="OnePlus-SM8850-Development/android_vendor_qcom_opensource_display-core"
           path="hardware/qcom-caf/sm8750/display/core" remote="github"
           revision="lineage-23.2-caf-sm8850" />

  <remove-project name="LineageOS/android_hardware_qcom_display" />
  <project name="OnePlus-SM8850-Development/android_hardware_qcom_display"
           path="hardware/qcom-caf/sm8750/display/hal" remote="github"
           revision="lineage-23.2-caf-sm8850" />

  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-intf" />
  <project name="OnePlus-SM8850-Development/android_vendor_qcom_opensource_display-intf"
           path="hardware/qcom-caf/sm8750/display/intf" remote="github"
           revision="lineage-23.2-caf-sm8850" />

  <!-- OPTIONAL: forks instead of patches/ (heavier; only if you don't want the
       apply-patches.sh step). Push the listed branches first, then uncomment:
  <remove-project name="LineageOS/android_frameworks_base" />
  <project name="IronShing/android_frameworks_base"
           path="frameworks/base" remote="github" revision="nx809j" />

  <remove-project name="LineageOS/android_vendor_lineage" />
  <project name="IronShing/android_vendor_lineage"
           path="vendor/lineage" remote="github" revision="nx809j" />

  <remove-project name="platform/packages/apps/CarrierConfig" />
  <project name="IronShing/android_packages_apps_CarrierConfig"
           path="packages/apps/CarrierConfig" remote="github" revision="nx809j-volte-41902" />
  -->
</manifest>
